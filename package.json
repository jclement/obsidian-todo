{
  "name": "obsidian-todo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:server": "bun --watch src/server.ts",
    "dev:client": "vite",
    "build:css": "@tailwindcss/cli -i styles/app.css -o public/app.css --minify",
    "build:client": "vite build",
    "build:server": "bun build src/server.ts --target bun --outdir dist --minify",
    "build": "bunx @tailwindcss/cli -i styles/app.css -o public/app.css --minify && vite build && bun build src/server.ts --target bun --outdir dist --minify",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@simplewebauthn/server": "^13.3.1",
    "hono": "^4.12.0",
    "lucide-react": "^1.20.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.66.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@use-gesture/react": "^10.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "framer-motion": "^11.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^6.0.11"
  }
}
